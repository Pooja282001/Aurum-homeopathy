# Aurum Homeopathy - API URL Rewriting
# Convert /api/backend.php/endpoint to /api/backend.php?action=endpoint

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Skip rewriting for actual files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite /api/backend.php/... to /api/backend.php?action=...
    RewriteRule ^api/backend\.php/(.*)$ api/backend.php?action=$1 [L,QSA]
</IfModule>

# Set correct MIME types
AddType application/json .json
AddType text/javascript .js

# Enable CORS headers (if mod_headers is available)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
